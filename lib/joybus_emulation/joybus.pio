; Device side of the joybus line (GameCube and N64 controller ports)
; The state machine runs at 25MHz (the clock divider is derived from clk_sys), so each cycle is 40ns.
;
; Receiving: every bit is sampled ~2.5us after its falling edge, and bytes are autopushed. Within a
; command the line is never high for more than 3.75us (a 1 bit from a GameCube, whose bits are 5us),
; so once it has been high for ~4.5us the command (including its stop bit) is over. The program then
; drops the stop bit it sampled, pushes 0xFFFFFFFF (which a byte never is) to mark the end of the
; command, and waits for the CPU's reply.
;
; Replying: the reply is a succession of (value, enable) bit pairs, LSB first. A pair with enable
; clear ends the reply. The CPU can queue the reply as soon as it has seen the whole command, so it
; normally goes out at a fixed time after the stop bit. If nothing is queued within ~44us (because
; there is no reply, or the CPU had interrupts off) the program goes back to listening, so a late
; reply can't go out on top of the console's next command. Needs the mov status set to "TX FIFO
; empty" (STATUS_TX_LESSTHAN, 1).
.program joybus
PUBLIC outmode:
    pull block
    out x, 1                ; x = what should we output
    out y, 1                ; y = should we output something
    set pins, 1             ; set the level first so taking the line doesn't glitch it low
    set pindirs, 1
bit:                        ; 4us a bit
    set pins, 0 [24]
    mov pins, x [24]
    mov pins, x [24]
    set pins, 1 [20]
    pull ifempty block
    out x, 1
    out y, 1
    jmp y-- bit
    jmp !x inmode           ; GameCube already sent its ordinary stop bit
    set pins, 0 [31]        ; N64 stop bit: hold low for 2us, then release
    set pins, 0 [17]
.wrap_target
PUBLIC inmode:
    set pindirs, 0
    mov isr, null
    wait 0 pin 0 [2]        ; about as late as the idle loop below notices a falling edge
idle:
    jmp pin still_high      ; 4 cycles a loop, 28 loops is ~4.5us
bit_low:
    nop [31]
    nop [25]
    in pins, 1              ; ~2.5us after the falling edge
    wait 1 pin 0
    set x, 27
still_high:
    jmp x-- idle [2]
PUBLIC end_of_command:      ; from here to the end, the program is waiting for a reply
    mov isr, ~null          ; the line stayed high, so the command is over
    push block
    set y, 31
reply_wait:                 ; 34 cycles a loop, 32 loops is ~44us
    mov x, status           ; all ones while the TX FIFO is empty
    jmp !x outmode
    jmp y-- reply_wait [31]
.wrap                       ; nothing came, so listen again

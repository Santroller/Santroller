; Sends commands to an Xbox 360 RF module (the ring of light / wireless receiver board).
; The module drives the clock: pulling data low asks it to start clocking, then each
; bit is presented after a falling edge and sampled by the module on the rising edge.
;
; in_base = clock, set_base / out_base = data
; Per command the CPU pushes (bit count - 1), then the bits left aligned (MSB first).
; ISR holds the hold time after each falling edge, in SM cycles (loaded at init).
.program xbox360_rf
.wrap_target
    pull block
    mov x, osr
    pull block
    set pins, 0
    set pindirs, 1      ; data low: start condition
bitloop:
    wait 0 pin 0
    mov y, isr
hold:
    jmp y-- hold
    out pins, 1
    wait 1 pin 0
    jmp x-- bitloop
    set pins, 1
    set pindirs, 0      ; release data
.wrap

% c-sdk {
static inline void xbox360_rf_program_init(PIO pio, uint sm, uint offset, uint data_pin, uint clock_pin, uint32_t hold_cycles)
{
    pio_gpio_init(pio, data_pin);
    pio_gpio_init(pio, clock_pin);
    gpio_pull_up(data_pin);
    gpio_pull_up(clock_pin);
    pio_sm_set_pins_with_mask(pio, sm, 1u << data_pin, 1u << data_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, data_pin, 1, false);
    pio_sm_set_consecutive_pindirs(pio, sm, clock_pin, 1, false);

    pio_sm_config c = xbox360_rf_program_get_default_config(offset);
    sm_config_set_in_pins(&c, clock_pin);
    sm_config_set_set_pins(&c, data_pin, 1);
    sm_config_set_out_pins(&c, data_pin, 1);
    sm_config_set_out_shift(&c, false, false, 32);
    // 1MHz, so the hold time is in microseconds
    sm_config_set_clkdiv(&c, clock_get_hz(clk_sys) / 1000000.0f);
    pio_sm_init(pio, sm, offset, &c);

    // stash the hold time in ISR, which nothing else uses
    pio_sm_put_blocking(pio, sm, hold_cycles);
    pio_sm_exec(pio, sm, pio_encode_pull(false, true));
    pio_sm_exec(pio, sm, pio_encode_mov(pio_isr, pio_osr));
    pio_sm_set_enabled(pio, sm, true);
}
%}

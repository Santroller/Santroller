PRIMARY_SERVICE, GAP_SERVICE
CHARACTERISTIC, GAP_DEVICE_NAME, READ, "SantrollerBT"

// add Battery Service
#import <battery_service.gatt>

// add Device ID Service
#import <device_information_service.gatt>

// Keyboard / mouse GATT database (KeyboardMouse profiles), the counterpart of bt.gatt for the gamepad.
// Its HID service only references the reports in desc_hid_report_keyboard: hids.gatt's keyboard input and
// lock light output (id 1), plus the mouse (2) and media keys (3). Regenerate the header after editing:
//   lib/btstack/tool/compile_gatt.py src/emulation/bt/bt_keyboard.gatt include/emulation/bt/bt_keyboard_profile.h

// add HID Service
#import <hids.gatt>
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | NOTIFY | ENCRYPTION_KEY_SIZE_16,
// Mouse (MOUSE_REPORT_ID), type = Input (1)
REPORT_REFERENCE, READ, 2, 1

CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | NOTIFY | ENCRYPTION_KEY_SIZE_16,
// Media keys (CONSUMER_REPORT_ID), type = Input (1)
REPORT_REFERENCE, READ, 3, 1

// Second HID service carrying only the vendor config collection, so the configurator can talk to the
// device over bluetooth the same way it does over USB. Handled by bt_config_service, not hids_device.
PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_HUMAN_INTERFACE_DEVICE
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT_MAP, DYNAMIC | READ,
// bcdHID = 0x101 (v1.0.1), bCountryCode 0, normally connectable 2
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_HID_INFORMATION, READ, 01 01 00 02
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_HID_CONTROL_POINT, DYNAMIC | WRITE_WITHOUT_RESPONSE,
// Config events, type = Input (1)
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | NOTIFY | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 22, 1
// Feature reports (3). Only WRITE (not WRITE_WITHOUT_RESPONSE), so every write can be acknowledged once it is handled
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 22, 3
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 23, 3
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 24, 3
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 25, 3
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 26, 3
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 27, 3
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 28, 3
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 29, 3
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 30, 3
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 31, 3
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 32, 3
// Firmware upload, type = Output (2)
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 31, 2

// The same config reports as a plain GATT service, for Web Bluetooth (which blocks HID services).
// One characteristic per report id (the last byte of the UUID): read = get feature report,
// write = set feature report, and the 0x22 characteristic notifies config events.
PRIMARY_SERVICE, 53414E54-524F-4C4C-4552-000000000000
CHARACTERISTIC, 53414E54-524F-4C4C-4552-000000000022, DYNAMIC | READ | WRITE | NOTIFY | ENCRYPTION_KEY_SIZE_16,
CHARACTERISTIC, 53414E54-524F-4C4C-4552-000000000023, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
CHARACTERISTIC, 53414E54-524F-4C4C-4552-000000000024, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
CHARACTERISTIC, 53414E54-524F-4C4C-4552-000000000025, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
CHARACTERISTIC, 53414E54-524F-4C4C-4552-000000000026, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
CHARACTERISTIC, 53414E54-524F-4C4C-4552-000000000027, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
CHARACTERISTIC, 53414E54-524F-4C4C-4552-000000000028, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
CHARACTERISTIC, 53414E54-524F-4C4C-4552-000000000029, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
CHARACTERISTIC, 53414E54-524F-4C4C-4552-000000000030, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
CHARACTERISTIC, 53414E54-524F-4C4C-4552-000000000031, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
CHARACTERISTIC, 53414E54-524F-4C4C-4552-000000000032, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,

PRIMARY_SERVICE, GATT_SERVICE
CHARACTERISTIC, GATT_DATABASE_HASH, READ,
